# WHITE configuration. Copy to .env and fill in. All values are optional for the CLI.

# --- Supabase (optional): enables accounts and cloud scan history in the GUI ---
# Project URL and the PUBLISHABLE key (sb_publishable_...) or legacy anon key.
# Never put the service_role / secret key here: WHITE does not use it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Web application ---
# Long random string used to sign CSRF tokens and encrypt stored sessions.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
WHITE_SECRET_KEY=replace-with-a-long-random-string
# Public address of the GUI; used in email links (must be allowed in Supabase Auth redirect URLs).
WHITE_SITE_URL=http://127.0.0.1:8000
# Where local data (SQLite: sessions, domain verification, local-mode history) is stored.
# WHITE_DATA_DIR=~/.white
# Require DNS/file domain verification before scanning (default: true when Supabase is configured).
# WHITE_REQUIRE_DOMAIN_VERIFICATION=true

# --- Operator admin console (/admin) ---
# A separate login that shows all registered users and everyone's scans. Enabled by default for
# local use with the credentials below (change them for anything shared).
# WHITE_ADMIN_USER=nihal
# WHITE_ADMIN_PASSWORD=nihal
# For a strong password, set a hash instead of the plaintext above and remove WHITE_ADMIN_PASSWORD:
#   python -c "from white.auth.passwords import hash_password; print(hash_password('your-strong-password'))"
# WHITE_ADMIN_PASSWORD_HASH=pbkdf2_sha256$...
# WHITE_ADMIN_ENABLED=true
# To list registered users and their emails, the console needs the Supabase SERVICE-ROLE key.
# It is used only server-side by /admin and never sent to the browser. Leave unset to show only
# locally stored scans. Keep this secret out of Git.
# WHITE_SUPABASE_SERVICE_KEY=sb_secret_...

# --- Scanner limits (safe defaults) ---
# WHITE_REQUEST_TIMEOUT=10
# WHITE_MAX_SCAN_SECONDS=120
# WHITE_MAX_RESPONSE_BYTES=2000000
# WHITE_MAX_CONCURRENT_SCANS=3
# WHITE_SCANS_PER_USER_PER_HOUR=20
# Development only: allow the GUI/API to scan localhost/private addresses. Never enable when hosted.
# WHITE_ALLOW_PRIVATE_TARGETS=false
